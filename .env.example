# Firebase config — get these from Firebase console (Project settings → General → Your apps → SDK setup)
# Copy this file to .env and fill in real values, then restart `npm run dev`.
# All vars MUST be prefixed VITE_ to be exposed to the browser.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# EmailJS — backup admin notification on every new order.
# Sign up at https://www.emailjs.com (free 200 emails/month):
#   1. Add an email service (Gmail / Outlook / etc.)
#   2. Create a template — see placeholders in src/services/emailNotify.js
#   3. Copy the IDs below.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
# Optional: separate template to send a confirmation to the customer.
# Configure with To Email = {{to_email}} in the EmailJS template settings.
VITE_EMAILJS_CUSTOMER_TEMPLATE_ID=

# Optional: Firebase App Check — blocks anyone who lifts the Firebase config
# out of the published bundle from writing to Firestore from a script.
# Uses reCAPTCHA ENTERPRISE; the plain reCAPTCHA v3 provider is deprecated for
# new integrations and the console says so.
#   1. Google Cloud -> Security -> Fraud Defense -> Create key
#      Type Web, domains akbarhusen3411.github.io AND localhost,
#      "Use checkbox challenge" UNCHECKED (score-based)
#   2. Firebase console -> Build -> App Check -> Apps -> your Web app ->
#      reCAPTCHA Enterprise -> paste the key ID -> token TTL 1 day
#   3. Put the same key ID below. Enterprise has NO secret — one value only.
# Free within 10,000 assessments/month, and works on the no-cost Spark plan.
# Leave blank and App Check simply does not run.
# Do NOT switch on Enforce in the console until the App Check metrics show
# ~100% verified requests, or live orders start silently failing to save.
VITE_RECAPTCHA_SITE_KEY=

# Optional: SnapWidget Instagram feed widget ID
VITE_SNAPWIDGET_ID=
# service_wvulvdp
# template_d1fvxpm
# publicKey 8szfUhf8Kl0nxUihL