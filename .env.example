# Firebase config — get these from Firebase console (Project settings → General → Your apps → SDK setup)
# Copy this file to .env and fill in real values, then restart `npm run dev`.
# All vars MUST be prefixed VITE_ to be exposed to the browser.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# EmailJS — backup admin notification on every new order.
# Sign up at https://www.emailjs.com (free 200 emails/month):
#   1. Add an email service (Gmail / Outlook / etc.)
#   2. Create a template — see placeholders in src/services/emailNotify.js
#   3. Copy the IDs below.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
# Optional: separate template to send a confirmation to the customer.
# Configure with To Email = {{to_email}} in the EmailJS template settings.
VITE_EMAILJS_CUSTOMER_TEMPLATE_ID=

# Optional: SnapWidget Instagram feed widget ID
VITE_SNAPWIDGET_ID=
